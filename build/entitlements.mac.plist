<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron's JIT needs all three; they are electron-builder's defaults, and
       library validation in particular has to stay off because koffi loads
       fn-hook.dylib and typer.dylib, which carry their own ad-hoc signatures
       rather than the app's. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- The whole point of the app. Under the hardened runtime the microphone is
       refused outright without this — no prompt, and no entry in System Settings
       to grant after the fact, since that list only holds apps that got as far
       as asking. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
